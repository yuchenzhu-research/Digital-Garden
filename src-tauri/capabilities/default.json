{
  "$schema": "../gen/schemas/desktop-schema.json",
  "description": "enables the default permissions",
  "identifier": "default",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "log:default",
    "fs:default",
    "core:path:default",
    "os:default",
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "$APPDATA/**" }, { "path": "$DOCUMENT/**" }]
    }
  ]
}